// OAuth client ID of a Google Cloud "iOS" OAuth client (see README).
// Put your own value into Config/Secrets.xcconfig (git-ignored):
//   GOOGLE_CLIENT_ID = 1234567890-abc.apps.googleusercontent.com
// Alternatively, enter the client ID in the app on first launch.
GOOGLE_CLIENT_ID =

// App version (shown in "About Mailmeg"). Bump MARKETING_VERSION for every release and
// tag the commit as vX.Y.Z; CI sets CURRENT_PROJECT_VERSION (build number) automatically.
MARKETING_VERSION = 1.5.0
CURRENT_PROJECT_VERSION = 1

#include? "Secrets.xcconfig"
